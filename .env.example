GHCR_OWNER=your-github-user
GHCR_REPO=subtrack
PORT=3000
# Use an ABSOLUTE path on the server so data survives Dockhand re-cloning the repo
HOST_DATA_DIR=/opt/stacks/subtrack/data
PUID=1000
PGID=1000
TZ=Asia/Kolkata
CURRENCY=INR
# Optional built-in basic auth (leave empty when SSO/proxy auth sits upstream)
AUTH_USER=
AUTH_PASS=
# Optional webhook: discord | slack | ntfy | gotify | generic
WEBHOOK_URL=
WEBHOOK_TYPE=generic
WEBHOOK_DAYS=3
SEED_DEMO=false
